{
  "rules": {
    "approved": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'"
      }
    },
    "pending": {
      ".read": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'magionadmin@magionacademy.app')",
        ".validate": "!newData.exists() || (newData.child('id').isString() && newData.child('id').val().length <= 20 && newData.child('at').isNumber())"
      }
    },
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.token.email === 'magionadmin@magionacademy.app' || (auth.uid === $uid && (data.exists() || root.child('approved').child($uid).val() === true)))",
        ".validate": "newData.hasChildren(['nick', 'look']) && newData.child('nick').isString() && newData.child('nick').val().length >= 1 && newData.child('nick').val().length <= 8 && newData.child('look').isNumber() && (!newData.child('house').exists() || newData.child('house').val() === 'dew' || newData.child('house').val() === 'ember' || newData.child('house').val() === 'dusk' || newData.child('house').val() === 'moon')"
      }
    },
    "online": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'magionadmin@magionacademy.app')",
        "m": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "y": {
          ".validate": "newData.isNumber()"
        },
        "s": {
          ".validate": "newData.child('t').isString() && newData.child('t').val().length >= 1 && newData.child('t').val().length <= 40 && newData.child('at').isNumber()"
        }
      }
    },
    "market": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid) || (data.exists() && !data.child('buyer').exists() && newData.exists() && newData.child('buyer').val() === auth.uid && newData.child('uid').val() === data.child('uid').val() && newData.child('item').val() === data.child('item').val() && newData.child('qty').val() === data.child('qty').val() && newData.child('price').val() === data.child('price').val()))",
        ".validate": "!newData.exists() || (newData.child('item').isString() && newData.child('qty').isNumber() && newData.child('qty').val() >= 1 && newData.child('qty').val() <= 99 && newData.child('price').isNumber() && newData.child('price').val() >= 1 && newData.child('price').val() <= 9999)"
      }
    },
    "coop": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "$week": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
        }
      }
    },
    "guest": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "$host": {
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && $host !== auth.uid) || $host === auth.uid)",
          ".validate": "!newData.exists() || (newData.child('uid').isString() && newData.child('text').isString() && newData.child('text').val().length <= 40 && newData.child('at').isNumber())"
        }
      }
    },
    "defense": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "ctl": {
        ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'"
      },
      "st": {
        ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'"
      },
      "cmd": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "pick": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'magionadmin@magionacademy.app')",
          ".validate": "!newData.exists() || (newData.child('z').isNumber() && newData.child('z').val() >= 0 && newData.child('z').val() <= 2 && newData.child('s').isNumber() && newData.child('s').val() >= 0 && newData.child('s').val() <= 5 && newData.child('job').isString() && newData.child('job').val().length <= 10 && newData.child('n').isString() && newData.child('n').val().length <= 8)"
        }
      }
    },
    "events": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "dragon": {
        "$key": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
          }
        }
      }
    },
    "exam": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "$week": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        }
      }
    },
    "houses": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "$house": {
        ".write": "auth != null && root.child('players/' + auth.uid + '/house').val() === $house",
        ".validate": "newData.child('stage').isNumber() && newData.child('stage').val() >= 1 && newData.child('stage').val() <= 6 && (!data.exists() || newData.child('stage').val() >= data.child('stage').val())"
      }
    },
    "games": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null",
        "st": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'play' || newData.val() === 'end'"
        }
      }
    },
    "records": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "$g": {
        "$w": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          }
        }
      }
    },
    "chat": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "$day": {
        "$id": {
          ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
          ".validate": "newData.child('t').isString() && newData.child('t').val().length <= 42 && newData.child('at').isNumber()"
        }
      }
    },
    "npcs": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'"
    },
    "story": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "live": {
        ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'"
      },
      "ch": {
        "$c": {
          ".write": "auth != null"
        }
      },
      "wx": {
        ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'"
      },
      "band": {
        ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'"
      },
      "mq": {
        ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'"
      }
    },
    "adm": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      "heart": {
        ".read": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'magionadmin@magionacademy.app')",
          "$npc": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -10 && newData.val() <= 10)"
          }
        }
      },
      "reset": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'"
        }
      }
    },
    "pens": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "$i": {
        ".write": "auth != null && (auth.token.email === 'magionadmin@magionacademy.app' || ($i.matches(/^([0-9]|1[01])$/) && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))))",
        ".validate": "newData.isString()"
      }
    },
    "xparty": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null",
        "st": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'run' || newData.val() === 'end'"
        }
      }
    },
    "xrun": {
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "jobs": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      "$job": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
      }
    },
    "puzzle": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      "own": {
        "$pid": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || auth != null && auth.token.email === 'magionadmin@magionacademy.app')",
          ".validate": "newData.isString()"
        }
      },
      "board": {
        "$pid": {
          ".write": "auth != null && ((!data.exists() && root.child('puzzle/own/' + $pid).val() === auth.uid) || auth != null && auth.token.email === 'magionadmin@magionacademy.app')",
          ".validate": "newData.isString()"
        }
      },
      "chest": {
        "$i": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || auth != null && auth.token.email === 'magionadmin@magionacademy.app')",
          ".validate": "newData.isString()"
        }
      }
    },
    "lantern": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      "cnt": {
        "$u": {
          ".write": "auth != null && (auth.uid === $u || auth != null && auth.token.email === 'magionadmin@magionacademy.app')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && (!data.exists() || newData.val() >= data.val() || auth != null && auth.token.email === 'magionadmin@magionacademy.app')"
        }
      },
      "color": {
        "$i": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || auth != null && auth.token.email === 'magionadmin@magionacademy.app')",
          ".validate": "newData.isString()"
        }
      }
    },
    "pumpkin": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'magionadmin@magionacademy.app'",
      "pts": {
        "$u": {
          ".write": "auth != null && (auth.uid === $u || auth != null && auth.token.email === 'magionadmin@magionacademy.app')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000 && (!data.exists() || newData.val() >= data.val() || auth != null && auth.token.email === 'magionadmin@magionacademy.app')"
        }
      },
      "w": {
        "$u": {
          ".write": "auth != null && (auth.uid === $u || auth != null && auth.token.email === 'magionadmin@magionacademy.app')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000 && (!data.exists() || newData.val() >= data.val() || auth != null && auth.token.email === 'magionadmin@magionacademy.app')"
        }
      }
    }
  }
}